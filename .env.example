# Salin menjadi .env lalu isi nilainya
PORT=3000
NODE_ENV=development
# WAJIB di production: string acak panjang (contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# Lokasi file database SQLite (default: ./data/bengkelku.db)
DB_PATH=
# Akun Admin Platform yang dibuat saat database pertama kali kosong
ADMIN_EMAIL=admin@bengkelku.id
ADMIN_PASSWORD=
# true = isi data contoh (bengkel, mekanik, customer, booking). Set false untuk database bersih.
SEED_DEMO=true

# Alamat publik aplikasi (dipakai untuk tautan reset password), mis. https://bengkelku.onrender.com
APP_URL=
# Opsional: agar email reset password benar-benar terkirim. Contoh: smtps://user:password@smtp.penyedia.com:465
SMTP_URL=
MAIL_FROM=BengkelKu <no-reply@contoh.com>
